ssh_username         = "ubuntu"
ssh_private_key_file = "/home/YOUR_USER/.ssh/kubespray-lab"
ssh_public_key_file  = "/home/YOUR_USER/.ssh/kubespray-lab.pub"
vm_hostname          = "ubuntu-2404-k8s-template"
headless             = true
cpus                 = 2
memory               = 4096
disk_size            = 32768

# Optional: password_hash = "$6$..." for a console password.
# Default is a locked password. SSH uses public-key authentication only.
