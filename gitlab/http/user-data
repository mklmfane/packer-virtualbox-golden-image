#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: gitlab-lab
    username: packer
    # password: packer
    # Generate your own hash with: openssl passwd -6 'packer'
    password: "$6$yAqH7x8Jc7wJ2Y0x$6e5oKQvQxwA1YbXn0A/5J1n9lGkQWc1q6n6qfQy2F0lR2yJ7kH7nE2Hh0mTtR6H5dFQm0nYx6qZK8lQ1d0"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINWytQGzKSCBDlNiPLr0slND86lDWgWJu6nHAGxKycOG mircea@packer-gitlab
  packages:
    - openssh-server
    - sudo
    - ca-certificates
    - curl
    - gnupg
  updates: security
  late-commands:
    - curtin in-target --target=/target -- bash -lc "echo 'packer ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/packer && chmod 440 /etc/sudoers.d/packer"
    - curtin in-target --target=/target -- bash -lc "systemctl enable ssh"
