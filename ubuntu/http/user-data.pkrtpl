#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ""
  timezone: Europe/Bucharest
  interactive-sections: []

  storage:
    layout:
      name: direct

  identity:
    hostname: ${hostname}
    username: ${ssh_username}
    password: "${password_hash}"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "${ssh_pubkey}"

  packages:
    - python3
    - python3-apt
    - curl
    - ca-certificates
    - openssh-server
    - virtualbox-guest-utils

  late-commands:
    - curtin in-target --target=/target -- bash -c "echo '${ssh_username} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-${ssh_username}-nopasswd"
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/90-${ssh_username}-nopasswd

    # Lock password (so password login is useless even locally)
    - curtin in-target --target=/target -- passwd -l ${ssh_username} || true

    # swap off
    - curtin in-target --target=/target -- swapoff -a
    - curtin in-target --target=/target -- sed -i.bak '/[[:space:]]swap[[:space:]]/ s/^/#/' /etc/fstab

    # modules + sysctl (don’t modprobe during install; can fail and abort install)
    - curtin in-target --target=/target -- bash -c "printf 'overlay\nbr_netfilter\n' > /etc/modules-load.d/k8s.conf"
    - curtin in-target --target=/target -- bash -c "printf 'net.bridge.bridge-nf-call-iptables=1\nnet.bridge.bridge-nf-call-ip6tables=1\nnet.ipv4.ip_forward=1\n' > /etc/sysctl.d/k8s.conf"
    # Make the VM safe to clone: regenerate IDs/keys on first boot
    - curtin in-target --target=/target -- rm -f /etc/ssh/ssh_host_*
    - curtin in-target --target=/target -- truncate -s 0 /etc/machine-id
    - curtin in-target --target=/target -- rm -f /var/lib/dbus/machine-id
    - curtin in-target --target=/target -- ln -sf /etc/machine-id /var/lib/dbus/machine-id
    - curtin in-target --target=/target -- cloud-init clean --logs || true
    - curtin in-target --target=/target -- rm -rf /var/lib/cloud/*

