#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: gitlab-lab
    username: packer
    # password: packer
    # Generate your own hash with: openssl passwd -6 'packer'
    password: "$6$DXFKEQfi.Z.I3N/9$23c5t.UzvmL/vxdcjmT/v2qMwlfYTmHIbSnAyzLt1uq3VB4XVMQ.0APranvYYryJerSoiNICL.wFK1vFiS27C0"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINWytQGzKSCBDlNiPLr0slND86lDWgWJu6nHAGxKycOG mircea@packer-gitlab
  packages:
    - openssh-server
    - sudo
    - ca-certificates
    - curl
    - gnupg
  updates: security
  late-commands:
    - curtin in-target --target=/target -- bash -lc "echo 'packer ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/packer && chmod 440 /etc/sudoers.d/packer"
    - curtin in-target --target=/target -- bash -lc "systemctl enable ssh"
